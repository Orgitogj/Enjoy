{
  "expo": {
    "name": "ENJOY",
    "slug": "WOLT",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/png/icon-1024.png",
    "scheme": "enjoy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orgito.enjoy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "We use your location to show nearby restaurants and to share courier position while an order is on its way.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C44720",
        "foregroundImage": "./assets/brand/png/adaptive-foreground-1024.png",
        "backgroundImage": "./assets/brand/png/adaptive-background-1024.png",
        "monochromeImage": "./assets/brand/png/monochrome-1024.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.orgito.enjoy",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/png/icon-1024.png"
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "wolt",
          "organization": "mobile-developing"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/png/splash-logo-light-1024.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F1",
          "dark": {
            "image": "./assets/brand/png/splash-logo-dark-1024.png",
            "backgroundColor": "#191512"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Allow $(PRODUCT_NAME) to use your location"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/png/monochrome-1024.png",
          "color": "#C44720",
          "defaultChannel": "default"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.orgito.WOLT",
          "enableGooglePay": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can upload your courier documents.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera so you can photograph your courier documents.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a3a1dfe0-c29d-4fa0-92ae-729b5fbbb81f"
      }
    }
  }
}
